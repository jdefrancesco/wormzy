[Unit]
Description=Wormzy QUIC relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wormzy
Group=wormzy
Environment=WORMZY_RELAY_LISTEN=:3478
Environment=WORMZY_RELAY_PAIR_IDLE=5m
Environment=WORMZY_RELAY_PAIR_LIFETIME=12h
EnvironmentFile=-/etc/wormzy/mailbox.env
EnvironmentFile=-/etc/wormzy/relay.env
ExecStart=/usr/local/bin/relay -listen ${WORMZY_RELAY_LISTEN} -pair-idle ${WORMZY_RELAY_PAIR_IDLE} -pair-lifetime ${WORMZY_RELAY_PAIR_LIFETIME}
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
